# Create an OAuth App at https://github.com/settings/developers.
# Enable Device Flow in the app settings, then copy its client ID here.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This 32-byte base64 value encrypts GitHub access tokens before they are saved locally.
CONNECTION_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# Optional
PORT=3000
# CONNECTION_STORE_PATH=./data/connections.json
